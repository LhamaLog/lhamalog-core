# RASCUNHO NAO VALIDADO. Nao e configuracao de producao pronta.
# Nao copie segredos para este arquivo. Nao versione um .env.prod preenchido.
# Estas variaveis NAO sao lidas do .env de desenvolvimento (prefixo PROD_).
# compose.prod.yaml nao publica Mongo nem Redis no host.
# Um config bem-sucedido nao significa que o deploy foi aceito.

PROD_API_BIND_ADDRESS=
PROD_API_PORT=8080
PROD_MONGO_ROOT_USERNAME=
PROD_MONGO_ROOT_PASSWORD=
PROD_MONGO_APP_DATABASE=lhamalog_core
PROD_MONGO_APP_USERNAME=
PROD_MONGO_APP_PASSWORD=
PROD_MONGODB_URI=
PROD_REDIS_PASSWORD=
PROD_REDIS_SSL_ENABLED=false
PROD_OTLP_ENABLED=false
PROD_OTLP_METRICS_URL=
PROD_OTLP_TRACES_URL=
PROD_CLERK_ISSUER=
PROD_CLERK_JWKS_URI=
PROD_CLERK_AUTHORIZED_PARTIES=
PROD_CLERK_ADMIN_ROLES=admin
