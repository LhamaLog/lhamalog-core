# Variaveis do ambiente local (ADR_151). Copie para .env nesta pasta (infra/local/.env).
# O .env e obrigatorio: as senhas do MongoDB, do Redis e o usuario/senha do OpenObserve nao tem valor
# padrao e o compose para com erro se faltarem. Os demais valores abaixo sao os padroes do compose.
# Somente desenvolvimento: nao use em producao. Nunca versione o .env.

# MongoDB (banco do Core - ADR_116). As senhas nao tem valor aqui: preencha no seu .env local.
# MONGO_APP_PASSWORD so vale na primeira subida (volume vazio); depois, troque com
# "docker compose -f infra/local/compose.yaml down -v" (apaga os dados locais).
MONGO_PORT=27017
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
MONGO_APP_DATABASE=lhamalog_core
MONGO_APP_USERNAME=lhamalog
MONGO_APP_PASSWORD=

# Redis. Senha obrigatoria: o compose para com erro se ficar vazia. Defina so no .env.
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenObserve (log store - ADR_168). Usuario deve ser um e-mail; senha com 8-128 caracteres,
# minuscula, maiuscula, digito e caractere especial. Preencha so no .env local.
OPENOBSERVE_PORT=5080
OPENOBSERVE_USERNAME=
OPENOBSERVE_PASSWORD=

# A aplicacao (perfil local) le as variaveis abaixo do ambiente, por exemplo (PowerShell):
#   $env:MONGODB_URI="mongodb://<usuario>:<senha>@localhost:27017/lhamalog_core?authSource=lhamalog_core"
#   $env:REDIS_PASSWORD="<mesma senha do REDIS_PASSWORD>"
#   $env:OPENOBSERVE_AUTH="Basic <base64 de usuario:senha do OpenObserve>"
# Sem o OpenObserve no ar? Desligue a exportacao OTLP com $env:OTLP_ENABLED="false".

# Aplicacao completa: compose.app.yaml (Core + Web + infraestrutura).
# Mesmos usuario, senha e banco acima, mas host mongo. Codifique caracteres
# especiais do usuario/senha na URI (percent-encoding). Nunca use a senha root.
MONGODB_URI_DOCKER=
# Instancia Clerk usada pelo frontend; nao precisa de secret key.
CLERK_ISSUER=
CLERK_JWKS_URI=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_ADMIN_ROLES=admin
