# Copie para .env na raiz do repositorio e preencha so na sua maquina.
#   cp .env.example .env
# O .env nao e versionado. Nao coloque senha real neste exemplo.
# Somente desenvolvimento. Producao usa .env.prod.example e compose.prod.yaml (nao validado).
#
# Senhas: use apenas letras e digitos. Caracteres @ : / ? # % $, espacos e aspas
# quebram a URI do Mongo ou a interpolacao do Compose. A mesma senha vai para o
# init do Mongo e para a URI interna da API. Nao use a senha root na aplicacao.
#
# Se ja existir infra/local/.env preenchido, copie-o para .env na raiz.
# Nao apague o arquivo antigo.

MONGO_PORT=27017
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
MONGO_APP_DATABASE=lhamalog_core
MONGO_APP_USERNAME=lhamalog
MONGO_APP_PASSWORD=

REDIS_PORT=6379
REDIS_PASSWORD=

API_PORT=8080

# OpenObserve e opcional (compose.observability.yaml). Nao e exigido pelo up padrao.
OPENOBSERVE_PORT=5080
OPENOBSERVE_USERNAME=
OPENOBSERVE_PASSWORD=
# Basic + base64 de usuario:senha. So quando OTLP_ENABLED=true.
OPENOBSERVE_AUTH=
OTLP_ENABLED=false

# Processo Java no host (make run-local). Nao use o hostname mongo aqui.
# O container da API monta a URI interna sozinho, com host mongo.
# MONGODB_URI=mongodb://lhamalog:SENHA_DE_LETRAS_E_DIGITOS@127.0.0.1:27017/lhamalog_core?authSource=lhamalog_core

# Origem publica do Web. Tambem e a lista CORS e o azp do Clerk.
# Varias origens: separe por virgula, sem espaco.
# Padrao do compose se a variavel estiver ausente: http://localhost:5173
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Clerk (LLT-163/164). Valores no Dashboard da Clerk (instancia de desenvolvimento). Nunca versione os valores.
#   CLERK_ISSUER              obrigatoria: Frontend API URL da instancia, sem barra final (a API nao sobe sem ela)
#   CLERK_JWKS_URI            opcional (padrao <CLERK_ISSUER>/.well-known/jwks.json)
#   CLERK_SECRET_KEY          secret key da Backend API (revoga sessoes no 403); vazia no local = revogacao pulada
#   CLERK_WEBHOOK_SIGNING_SECRET  Signing Secret do endpoint (Dashboard > Webhooks); vazio no local = webhooks rejeitados
#   DEV_TENANT_CLERK_ORG_ID   so no perfil local: um ou mais org_id, separados por virgula (ex.: org_exemploA1,org_exemploB2),
#                             que ganham um Tenant ACTIVE ao subir (atalho: sem Tenant, a organizacao recebe 403 subscription_required e precisa contratar um plano). Valores reais so no .env
# Processo Java no host: exporte as mesmas variaveis no terminal antes de rodar a API.
CLERK_ISSUER=
CLERK_JWKS_URI=
CLERK_ADMIN_ROLES=admin
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
DEV_TENANT_CLERK_ORG_ID=
# Contratacao de plano com o Asaas simulado (LLT-289, spec 010).
#   ASAAS_WEBHOOK_TOKEN  token do webhook do Asaas (32 a 255 caracteres); vazio no local = gerado ao subir
#   BILLING_RETURN_URL   para onde o navegador volta depois do pagamento
# Modulo Ocorrencia (spec 013): segredo do JWT interno do Finder, minimo 32 bytes; gere um valor so seu.
#   Rotacao: segredo novo e antigo separados por virgula ate o Finder trocar o token.
OCCURRENCE_INTERNAL_JWT_SECRETS=
ASAAS_WEBHOOK_TOKEN=
BILLING_RETURN_URL=http://localhost:5173/empresa
# O Web sobe no repositorio lhamalog-web, em http://localhost:5173.
# O navegador chama a API em http://localhost:8080. Nao ha rede Docker compartilhada.
