# Copie para .env na raiz do repositorio e preencha so na sua maquina.
#   cp .env.example .env
# O .env nao e versionado. Nao coloque senha real neste exemplo.
# Somente desenvolvimento. Producao usa .env.prod.example e compose.prod.yaml (nao validado).
#
# Senhas: use apenas letras e digitos. Caracteres @ : / ? # % $, espacos e aspas
# quebram a URI do Mongo ou a interpolacao do Compose. A mesma senha vai para o
# init do Mongo e para a URI interna da API. Nao use a senha root na aplicacao.
#
# Se ja existir infra/local/.env preenchido, copie-o para .env na raiz.
# Nao apague o arquivo antigo.

MONGO_PORT=27017
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
MONGO_APP_DATABASE=lhamalog_core
MONGO_APP_USERNAME=lhamalog
MONGO_APP_PASSWORD=

REDIS_PORT=6379
REDIS_PASSWORD=

API_PORT=8080

# OpenObserve e opcional (compose.observability.yaml). Nao e exigido pelo up padrao.
OPENOBSERVE_PORT=5080
OPENOBSERVE_USERNAME=
OPENOBSERVE_PASSWORD=
# Basic + base64 de usuario:senha. So quando OTLP_ENABLED=true.
OPENOBSERVE_AUTH=
OTLP_ENABLED=false

# Processo Java no host (make run-local). Nao use o hostname mongo aqui.
# O container da API monta a URI interna sozinho, com host mongo.
# MONGODB_URI=mongodb://lhamalog:SENHA_DE_LETRAS_E_DIGITOS@127.0.0.1:27017/lhamalog_core?authSource=lhamalog_core

# Origem publica do Web. Tambem e a lista CORS e o azp do Clerk.
# Varias origens: separe por virgula, sem espaco.
# Padrao do compose se a variavel estiver ausente: http://localhost:5173
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
CLERK_ISSUER=
CLERK_JWKS_URI=
CLERK_ADMIN_ROLES=admin

# O Web sobe no repositorio lhamalog-web, em http://localhost:5173.
# O navegador chama a API em http://localhost:8080. Nao ha rede Docker compartilhada.
